# ─────────────────────────────────────────────────────────────
# Periergia environment configuration
# Copy to `.env.local` and fill in. The app runs WITHOUT any of
# these set — it falls back to in-memory seed data + structured
# placeholder content so you can develop the full loop offline.
# ─────────────────────────────────────────────────────────────

# Claude — powers content, quiz, and open-answer grading.
# Without it, the app serves rich placeholder content instead.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8).
PERIERGIA_MODEL=claude-opus-4-8

# Supabase — stable syllabus tree + generated-content/quiz cache + media.
# Without these, the app uses the in-memory store (seed.ts) and an in-process
# cache. With them: run supabase/schema.sql, then `npm run seed` to load the
# tree into Postgres. The store (src/lib/store.ts) then reads the tree and
# reads/writes the cache from Postgres — no other code changes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (server-only — used by API routes to write the cache).
SUPABASE_SERVICE_ROLE_KEY=
